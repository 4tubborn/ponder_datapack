use ::java::util::block_state::BlockState
//use ::java::util::direction::Direction
//use ::java::util::direction::VerticalDirection
use ::java::util::color::RGB
use ::java::util::text::Text
use ::java::world::item::ItemStack
use ::java::world::item::ItemStackTemplate

dispatch minecraft:storage[ponder:index] to struct PonderSceneIndex {
  scene: struct {
    [string]: ( [PonderAction] | [[PonderAction]] )
  },
}

enum(string) EPonderActionType {
  Idle = "idle",
  ShowBasePlate = "show_base_plate",
  ShowBasePlateSmall = "show_base_plate_small",
  ShowBasePlateLarge = "show_base_plate_large",
  SetBlock = "set_block",
  SetBlocks = "set_blocks",
  ShowSection = "show_section",
  ModifyBlock = "modify_block",
  ModifyTileNbt = "modify_tile_nbt",
  ShowText = "show_text",
  ShowOutline = "show_outline",
  ShowControl = "show_control",
  CreateItemEntity = "create_item_entity",
  CreateEntity = "create_entity",
  RemoveEntity = "remove_entity",
  ModifyEntity = "modify_entity",
  HideSection = "hide_section",
  MoveSection = "move_section",
  ScaleCamera = "scale_camera",
  RotateCamera = "rotate_camera",
  RunCommand = "run_command",
  PlaySound = "play_sound",
}

type Vec3d = [double] @ 3
type Vec3i = int[] @ 3

enum(string) EDirection {
  North = "north",
  South = "south",
  West = "west",
  East = "east",
  Up = "up",
  Down = "down",
}

enum(string) EDirectionMotion {
  North = "north",
  South = "south",
  West = "west",
  East = "east",
  Up = "up",
  Down = "down",
  None = "none",
}

type Direction = ( #[canonical] EDirection | Vec3d )
type DirectionMotion = ( #[canonical] EDirectionMotion | Vec3d )

struct SetSingleBlock {
  block_state: BlockState,
  pos: Vec3i,
  //TODO
  state?: #[match_regex="^\\[(([a-z0-9_]+=[a-z0-9_]+,)*[a-z0-9_]+=[a-z0-9_]+,?)?\\]$"] string,
  //...ponder:block_state_handler[[block_state.Properties]],
  //mcdoc:block_states[[block_state.Name]]
}

// No it does not work!
dispatch ponder:block_state_handler[%none] to ()

dispatch ponder:block_state_handler[%unknown] to struct {
  /// List format of block states
  state: #[match_regex="^\\[(([a-z0-9_]+=[a-z0-9_]+,)*[a-z0-9_]+=[a-z0-9_]+,?)?\\]$"] string,
}

struct PonderAction {
	type: EPonderActionType,
	...ponder:action[[type]],
}

dispatch ponder:action[idle] to struct IdleAction {
  /// Delay duration in ticks
	duration: int @ 1..,
}

/// Shows a normal size of checkerboard
dispatch ponder:action[show_base_plate] to struct E {
}

/// Shows a small size of checkerboard
dispatch ponder:action[show_base_plate_small] to struct {
}

/// Shows a large size of checkerboard
dispatch ponder:action[show_base_plate_large] to struct {
}

/// Pushes one block into display list
dispatch ponder:action[set_block] to struct {
  /// Block position
  block: SetSingleBlock,
}

/// Pushes blocks into display list
dispatch ponder:action[set_blocks] to struct {
  /// A list of block positions
  blocks: [SetSingleBlock],
}

/// Shows all blocks in display list and clear display list
dispatch ponder:action[show_section] to struct {
  // Default: down
  /// The direction that blocks will go to
  direction?: Direction,
}

dispatch ponder:action[modify_block] to struct {
  pos: Vec3i,
  //TODO
  /// Format: block_id[state]{nbt}
  block: string,
  //#[id=block]
  // Default: false
  /// Whether show breaking particles
  show_particle?: boolean,
}

dispatch ponder:action[modify_tile_nbt] to struct {
  pos: Vec3i,
  //TODO
  /// data modify block ~ ~ ~ ...
  operation: string,
  // Default: false
  /// Whether show breaking particles
  show_particle?: boolean,
}

dispatch ponder:action[show_text] to struct {
  // Default: offset
  mode?: ("offset"|"top_right"),
  // Default: 30
  duration?: int @ 1..,
  text: Text,
  // Default: auto
  // auto: If the text is on the right, the alignment will be right, and vice versa.
  alignment?: TextAlignment,
  ...ponder:text[[mode]],
}

  enum(string) TextAlignment {
    Center = "center",
    Left = "left",
    Right = "right",
    Auto = "auto",
  }

  // Extra fields when mode:offset
  dispatch ponder:text[offset, %none] to struct {
    pos: Vec3d,
    // Default: 3
    /// The offset extended from the position
    offset?: double,
  }
  // Extra fields when mode:top_right
  dispatch ponder:text[top_right] to struct {
    // Default: [1,0.6]
    /// The crosshair is the origin. +x towards right & +y towards up
    grid?: [double] @ 2,
  }

dispatch ponder:action[show_outline] to struct {
  pos: Vec3d,
  // Default: 20
  duration?: int @ 1..,
  // Default: [1,1,1]
  scale?: Vec3d,
  // Default: 0
  /// Format Red<<16 + Green<<8 + Blue or [<R>,<G>,<B> @ 0..1]
  color?: RGB,
}

dispatch ponder:action[show_control] to struct {
  pos: Vec3d,
  // Default: 50
  duration?: int @ 1..,
  // Default: false
  /// Whether show a right click icon
  right_click?: boolean,
  // Default: false
  /// Whether show a left click icon
  left_click?: boolean,
  // Default: false
  /// Whether show a middle click icon
  middle_click?: boolean,
  // Default: <empty>
  /// Shows a sprite
  sprite?: #[id="texture"] string,
}

// Summoned entity will have "ponder.summoned_entity" tag
dispatch ponder:action[create_item_entity] to struct {
  pos: Vec3d,
  // Default: {}
  nbt?: minecraft:entity[item],
  // Spyglass has bugs when handling #[canonical]: 
  //  1. The priority of #[canonical] is even higher than #[since] and #[until].
  //  2. The struct marked #[canonical] in union type, the actually canonical field will not be struct.
  // For example, In ItemStackTemplate (#[canonical] ItemStack | #[since="26.1"] string), the auto-complete suggests string.
  /// Controls the item entity's Item NBT, with higher priority than the field of nbt
  item: ItemStackTemplate,
  // Default: none
  /// Controls the item entity's Motion NBT, with higher priority than the field of nbt
  motion?: DirectionMotion,
}

// Summoned entity will have "ponder.summoned_entity" tag
dispatch ponder:action[create_entity] to struct {
  pos: Vec3d,
  id: #[id=entity_type] string,
  // Default: {}
  nbt?: minecraft:entity[[id]],
  // Default: true
  /// Controls the entity's NoAI NBT, with higher priority than the field of nbt
  no_ai?: boolean,
}

dispatch ponder:action[remove_entity] to struct {
  selector: #[entity(type="entities")] string
}

dispatch ponder:action[modify_entity] to struct {
  selector: #[entity(amount="single",type="entities")] string,
  //TODO
  /// data modify entity @n ...
  operation: string,
}

dispatch ponder:action[hide_section] to struct {
  blocks: [Vec3i],
  // Default: down
  /// The direction that blocks will go to
  direction?: Direction,
}

dispatch ponder:action[move_section] to struct {
  blocks: [Vec3i],
  // Default: up
  /// The direction that blocks will go to
  direction?: Direction,
  // Default: 7
  duration?: int @ 1..,
}

dispatch ponder:action[scale_camera] to struct {
  radius: double @ -50..50,
  // Default: false
  add?: boolean,
}

// The `rotate_camera` will override active `rotate_camera` process.
dispatch ponder:action[rotate_camera] to struct {
  // With the distance between the position and the player as radius
  /// The center of rotation
  pos: Vec3d,
  // Default: 0
  yaw?: double @ -360..360,
  // Default: 0
  pitch?: double @ -360..360,
}

dispatch ponder:action[run_command] to struct {
  run: #[command] string,
}

// Check Wiki https://minecraft.wiki/w/Commands/playsound for definitions
// Played at the position of the player
dispatch ponder:action[play_sound] to struct {
  sound: #[id="sound_event"] string,
  category?: ("master"|"music"|"record"|"weather"|"block"|"hostile"|"neutral"|"player"|"ambient"|"voice"|"ui"),
  /// Default 1.0.
	volume?: float @ 0..1,
	/// Default 1.0.
	pitch?: float @ 0..1,
  /// Default 0.0
  min_volume?: float @ 0..1,
}